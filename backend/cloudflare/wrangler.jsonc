{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "usonian-luthier-api-preview",
  "main": "index.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "build": { "command": "bash backend/scripts/build-wasm.sh", "watch_dir": ["../core/src", "../wasm/src", "../core/data"] },
  "rules": [{"type":"CompiledWasm", "globs":["**/*.wasm"], "fallthrough":true}]
}
